
# generated by scaffold_notebook_workspace.py
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
runs/
eda_modules/

# Pages staging built by .github/workflows/pages.yml
_site/

# Python build artifacts
dist/
build/
*.egg-info/

# Tool and test caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment and local configuration. `.env` files are ignored so a stray one cannot be
# committed by accident; nothing here is a credential store.
.env
.env.*
!.env.example

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Downloaded benchmark data (841 MB): reproducible with `uv run python -m isdm.data.fetch`.
# No placeholder keeps this directory in the repository; it is created on first write.
data/screenspot_pro_windows/

# Reference PDFs: large binaries under mixed licences. The tracked manifest
# (docs/literature/manifest.tsv) plus `uv run python scripts/fetch_literature.py` rebuilds them,
# and docs/literature/INDEX.md records every citation. The bytes stay out of history.
docs/literature/*/*.pdf
